# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Server-Only Key (Bypasses RLS for admin/cron sync tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive Service Account Configuration
# Base64-encoded string of the Google Cloud service account JSON credentials
# e.g.: echo -n '{"type":"service_account",...}' | base64
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive Root / Master Notes Folder ID
GOOGLE_DRIVE_FOLDER_ID=

# Secret token to protect the scheduled sync route: /api/sync/drive
# Send in Authorization header: Bearer <DRIVE_SYNC_SECRET>
DRIVE_SYNC_SECRET=your-random-drive-sync-secret

# HMAC Secret used to sign short-lived file stream access tokens (30-60s)
SIGNED_TOKEN_SECRET=your-random-32-byte-hmac-secret-key

# Redis Configuration (Distributed session & document caching)
REDIS_HOST=your-redis-host.db.redis.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

